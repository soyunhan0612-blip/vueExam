{
  "description": "Harness 가드레일: 위험 명령 차단(PreToolUse), 턴 종료 시 빌드 검증(Stop)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/block_dangerous.py",
            "commandWindows": "python .codex/hooks/block_dangerous.py",
            "statusMessage": "위험 명령 검사",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_build.py",
            "commandWindows": "python .codex/hooks/stop_build.py",
            "statusMessage": "npm run build 검증",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
